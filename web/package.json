{
  "name": "@espface/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "espFace web renderer: Vite + Preact + TypeScript, served at /r/1/",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/size.mjs",
    "test": "vitest run",
    "freeze": "vitest run test/freeze.test.ts && node scripts/freeze-check.mjs",
    "e2e": "playwright test",
    "size": "node scripts/size.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "preact": "10.29.8",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@material-design-icons/svg": "0.14.15",
    "@playwright/test": "1.49.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7",
    "ws": "8.18.3"
  }
}
