{
  "name": "apppage",
  "version": "1.0.0",
  "description": "App landing page template",
  "private": true,
  "scripts": {
    "setup": "npm install && npm run copy-assets && npm run apply-content && npm run render-legal",
    "apply-content": "sh bin/apply-content.sh ${CONTENT:-content/bruchbuch}",
    "render-legal": "sh bin/render-legal.sh",
    "copy-assets": "npm run copy-bulma && npm run copy-fontawesome && npm run copy-inter",
    "copy-bulma": "cp node_modules/bulma/css/bulma.min.css src/assets/css/vendor/",
    "copy-fontawesome": "cp node_modules/@fortawesome/fontawesome-free/css/all.min.css src/assets/css/vendor/fontawesome/ && cp -r node_modules/@fortawesome/fontawesome-free/webfonts/* src/assets/fonts/fontawesome/",
    "copy-inter": "cp -r node_modules/@fontsource/inter/files/* src/assets/fonts/inter/"
  },
  "dependencies": {
    "bulma": "^0.9.4",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@fontsource/inter": "^5.0.16"
  }
}
